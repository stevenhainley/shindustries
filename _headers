# Cloudflare Pages headers. Strict CSP: no inline scripts anywhere on the site (every script is a file under /assets or /duckyguard),
# inline <style> blocks and style="" attributes are allowed, nothing loads from a third party. No trackers, no cookies.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src 'self' https://*.shindustries.co; manifest-src 'self'; form-action 'self' mailto:; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cache-Control: public, max-age=600, must-revalidate

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/duckyguard/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/explain/*.webp
  Cache-Control: public, max-age=2592000

/assets/explain/*.mp3
  Cache-Control: public, max-age=2592000

/assets/icons/*
  Cache-Control: public, max-age=2592000

/assets/og/*
  Cache-Control: public, max-age=604800

/duckyguard/assets/*
  Cache-Control: public, max-age=2592000

/assets/*.css
  Cache-Control: public, max-age=86400, must-revalidate

/assets/*.js
  Cache-Control: public, max-age=86400, must-revalidate

/assets/explain/*.css
  Cache-Control: public, max-age=86400, must-revalidate

/assets/explain/*.js
  Cache-Control: public, max-age=86400, must-revalidate

/join.html
  X-Robots-Tag: noindex, nofollow

/thanks.html
  X-Robots-Tag: noindex, nofollow
